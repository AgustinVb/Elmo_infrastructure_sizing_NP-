__pycache__/
*.py[cod]

# Local installers and binary artifacts
Miniconda3-latest-Linux-x86_64.sh

# Solver/generated outputs
outputEscenarios_*/
outputEscenarios*/
infeasible_log.txt

# Gurobi LP/IIS dumps (can exceed 100MB, shouldn't be versioned)
*.lp

# Entorno aislado de GCG y sus wheels: se reconstruye con pip, no se versiona
