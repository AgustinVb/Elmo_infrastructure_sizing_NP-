Miniconda3-latest-Linux-x86_64.sh

# Gurobi model/IIS debug dumps (temporary, can exceed GitHub's 100MB limit)
**/_iis_tmp/
*.lp

# Entorno y wheels de GCG (reinstalables, cientos de MB)
.venv_gcg/
wheels_gcg/

# Dumps del solver para GCG (model.mps, varmap.json, decomp.json, *.dec, gcg.log)
runs/

# Logs del IIS: pueden superar los 100MB que acepta GitHub
infeasible_log.txt

# Artefactos de GCG: regenerables y pesados (un MPS del monolitico de 4 años
# pesa 140 MB, sobre el limite de GitHub). Los resumenes (results.json,
# certificado.json, comparacion.json) y los logs si se versionan.
*.mps
*.dec
decomp.json
*.sol
gcg_stdout.log

# Salidas de las colas de corridas (el historial legible esta en cola.log)
cola*.stdout
cola*.stderr
